# Database - Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres?schema=public"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-SUPABASE-PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Product image hosts (optional) ──────────────────────────────────────────
# Comma-separated hostnames next/image may optimise. The Supabase hostname from
# NEXT_PUBLIC_SUPABASE_URL is allowed automatically.
# NEXT_PUBLIC_IMAGE_HOSTS="cdn.example.com,images.example.org"

# ── ShopFlow data source (optional) ─────────────────────────────────────────
# When both are set, the storefront uses ShopFlow instead of mock data.
# NEXT_PUBLIC_DATA_SOURCE="shopflow"
# SHOPFLOW_API_URL="https://shopflow.example.com/api"
# SHOPFLOW_API_KEY="your-shopflow-api-key"

# ── Development simulation (optional, mock mode only) ───────────────────────
# Simulate ShopFlow remote latency: artificial delay in ms per storefront request.
# NEXT_PUBLIC_MOCK_LATENCY_MS=1500
# Simulate ShopFlow failures: 0..1 probability that a storefront request fails.
# NEXT_PUBLIC_MOCK_FAIL_RATE=0.3
